{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File components/hooks/protected-file-guard/invoke-claude-hook.ps1"
          }
        ]
      }
    ]
  }
}
